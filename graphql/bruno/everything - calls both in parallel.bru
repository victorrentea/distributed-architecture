meta {
  name: everything - calls both in parallel
  type: graphql
  seq: 3
}

post {
  url: http://localhost:8080/graphql
  body: graphql
  auth: none
}

body:graphql {
  {
    customer(id: 1) {
      id
      name
      email
      addresses {
        city
      }
      orders {
        id
        total
      }
    }
  }
}
